# Server Configuration
PORT=8080
GIN_MODE=debug

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talkforge?sslmode=disable

# Authentication Secrets
JWT_SECRET=talkforge_super_secret_jwt_key_change_me_in_production

# Google OAuth (Optional, leave blank to use mock logins in development)
GOOGLE_CLIENT_ID=

# Admin User Bootstrapping
ADMIN_BOOTSTRAP_NAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123

# Gemini API Configuration
GEMINI_API_KEY=
QUEUE_POLL_INTERVAL_SECONDS=5

# Gemini Quota & Token Limits
GEMINI_DAILY_REQUEST_LIMIT=20
GEMINI_MONTHLY_REQUEST_LIMIT=300
GEMINI_DAILY_TOKEN_LIMIT=100000
GEMINI_MONTHLY_TOKEN_LIMIT=1500000


